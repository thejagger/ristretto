{
  "description": "ristretto deterministic gates: guards the house-rule files while a run is armed, formats touched files, and runs lint+typecheck+test on Stop/SubagentStop until green — see scripts/gate.js.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.js\" guard",
            "timeout": 10,
            "statusMessage": "ristretto: checking the write target..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.js\" quick",
            "timeout": 60,
            "statusMessage": "ristretto: formatting..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.js\" full",
            "timeout": 3600,
            "statusMessage": "ristretto: running gates (lint, typecheck, test)..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.js\" full subagent",
            "timeout": 3600,
            "statusMessage": "ristretto: running gates on subagent result..."
          }
        ]
      }
    ]
  },
  "modules": [
    "./board.tsx"
  ]
}
